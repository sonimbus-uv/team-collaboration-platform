<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.sonimbus.desktop.ui.files.SharedFilesController"
            styleClass="content-view"
            stylesheets="@../../css/theme.css">

    <fx:define>
        <ToggleGroup fx:id="viewModeGroup"/>
    </fx:define>

    <!-- ================= Filtros ================= -->
    <top>
        <VBox styleClass="filter-bar" spacing="10">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <!-- Controles antes que sus Label para que labelFor resuelva -->
            <GridPane hgap="12" vgap="4">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints/>
                    <ColumnConstraints/>
                    <ColumnConstraints/>
                    <ColumnConstraints/>
                </columnConstraints>

                <TextField fx:id="searchField" promptText="Nombre del archivo"
                           accessibleText="Buscar por nombre del archivo"
                           onAction="#onApplyFilters"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label text="Buscar" labelFor="$searchField" styleClass="filter-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>

                <ComboBox fx:id="typeCombo" prefWidth="170" accessibleText="Filtrar por tipo de archivo"
                          onAction="#onApplyFilters"
                          GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Todos"/>
                            <String fx:value="Documentos"/>
                            <String fx:value="Imágenes"/>
                            <String fx:value="Hojas de cálculo"/>
                            <String fx:value="Otros"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <Label text="Tipo" labelFor="$typeCombo" styleClass="filter-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <ComboBox fx:id="channelCombo" prefWidth="170" promptText="Todos los canales"
                          accessibleText="Filtrar por canal" onAction="#onApplyFilters"
                          GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Label text="Canal" labelFor="$channelCombo" styleClass="filter-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                <ComboBox fx:id="dateCombo" prefWidth="190" accessibleText="Filtrar por fecha"
                          onAction="#onDateFilterChanged"
                          GridPane.rowIndex="1" GridPane.columnIndex="3">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Cualquier fecha"/>
                            <String fx:value="Últimos 7 días"/>
                            <String fx:value="Últimos 30 días"/>
                            <String fx:value="Rango personalizado…"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <Label text="Fecha" labelFor="$dateCombo" styleClass="filter-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <!-- Modo de vista -->
                <HBox styleClass="segmented" accessibleText="Vista"
                      GridPane.rowIndex="1" GridPane.columnIndex="4">
                    <ToggleButton fx:id="listViewToggle" text="Lista" selected="true"
                                  toggleGroup="$viewModeGroup"
                                  styleClass="button-secondary, segment-left"
                                  accessibleText="Ver como lista" onAction="#onViewModeChanged"/>
                    <ToggleButton fx:id="gridViewToggle" text="Cuadrícula"
                                  toggleGroup="$viewModeGroup"
                                  styleClass="button-secondary, segment-right"
                                  accessibleText="Ver como cuadrícula" onAction="#onViewModeChanged"/>
                </HBox>
            </GridPane>

            <!-- Rango personalizado de fechas, oculto por defecto -->
            <GridPane fx:id="customRangeBox" hgap="12" vgap="4" visible="false" managed="false">
                <DatePicker fx:id="startDatePicker" prefWidth="170" promptText="dd/mm/aaaa"
                            accessibleText="Fecha inicial" onAction="#onApplyFilters"
                            GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label text="Desde" labelFor="$startDatePicker" styleClass="filter-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <DatePicker fx:id="endDatePicker" prefWidth="170" promptText="dd/mm/aaaa"
                            accessibleText="Fecha final" onAction="#onApplyFilters"
                            GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Hasta" labelFor="$endDatePicker" styleClass="filter-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </top>

    <!-- ================= Archivos + vista previa ================= -->
    <center>
        <StackPane>
            <HBox fx:id="resultsBox">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="8" right="24" bottom="16" left="24"/>
                    </padding>

                    <StackPane VBox.vgrow="ALWAYS">
                        <!-- Vista de lista -->
                        <TableView fx:id="filesTable" styleClass="data-table"
                                   accessibleText="Lista de archivos compartidos">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="Sin archivos" styleClass="empty-state"/>
                            </placeholder>
                            <columns>
                                <TableColumn fx:id="nameColumn" text="Nombre" prefWidth="280"/>
                                <TableColumn fx:id="typeColumn" text="Tipo" prefWidth="120"/>
                                <TableColumn fx:id="channelColumn" text="Canal" prefWidth="120"/>
                                <TableColumn fx:id="authorColumn" text="Compartido por" prefWidth="140"/>
                                <TableColumn fx:id="dateColumn" text="Fecha" prefWidth="120"/>
                                <TableColumn fx:id="sizeColumn" text="Tamaño" prefWidth="90"/>
                                <TableColumn fx:id="actionsColumn" text="Acciones" prefWidth="110"
                                             sortable="false"/>
                            </columns>
                        </TableView>

                        <!-- Vista de cuadrícula, oculta por defecto -->
                        <ScrollPane fx:id="filesGridScroll" fitToWidth="true" hbarPolicy="NEVER"
                                    styleClass="plain-scroll" visible="false" managed="false">
                            <TilePane fx:id="filesGridPane" hgap="12" vgap="12"
                                      accessibleText="Cuadrícula de archivos compartidos"/>
                        </ScrollPane>
                    </StackPane>

                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="filesCountLabel" text="0 archivos" styleClass="section-subtitle"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="loadMoreButton" text="Cargar más" styleClass="button-secondary"
                                onAction="#onLoadMore"/>
                    </HBox>
                </VBox>

                <!-- Agregado: panel de vista previa del archivo seleccionado, oculto por defecto -->
                <VBox fx:id="previewPane" styleClass="side-panel" spacing="12"
                      minWidth="300" prefWidth="320" maxWidth="320"
                      visible="false" managed="false">
                    <padding>
                        <Insets top="16" right="20" bottom="16" left="20"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Vista previa" styleClass="panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="closePreviewButton" styleClass="icon-button-small"
                                accessibleText="Cerrar vista previa" onAction="#onClosePreview">
                            <graphic>
                                <SVGPath styleClass="icon-stroke, icon-small"
                                         content="M6 6l12 12M18 6L6 18"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Cerrar vista previa"/>
                            </tooltip>
                        </Button>
                    </HBox>

                    <StackPane styleClass="preview-box" minHeight="200" prefHeight="200">
                        <Label fx:id="previewTypeLabel" styleClass="file-type-badge"/>
                        <ImageView fx:id="previewImageView" fitWidth="278" fitHeight="198"
                                   preserveRatio="true" pickOnBounds="true"/>
                    </StackPane>

                    <Label fx:id="previewNameLabel" styleClass="panel-item-title" wrapText="true"/>
                    <Label fx:id="previewDetailsLabel" styleClass="section-subtitle" wrapText="true"/>

                    <Button fx:id="downloadButton" text="Descargar" styleClass="button-primary"
                            maxWidth="1.7976931348623157E308" onAction="#onDownload"/>
                    <Button fx:id="goToMessageButton" text="Ir al mensaje" styleClass="button-secondary"
                            maxWidth="1.7976931348623157E308" onAction="#onGoToMessage"/>
                </VBox>
            </HBox>

            <!-- Estado vacío (Archivos-vacio), oculto por defecto -->
            <VBox fx:id="emptyStateBox" styleClass="empty-card" alignment="CENTER" spacing="12"
                  maxWidth="440" maxHeight="-Infinity" visible="false" managed="false">
                <padding>
                    <Insets top="40" right="32" bottom="40" left="32"/>
                </padding>
                <SVGPath styleClass="icon-stroke-muted"
                         content="M9 21a6 6 0 0 1 6-6h12l6 6h24a6 6 0 0 1 6 6v27a6 6 0 0 1-6 6H15a6 6 0 0 1-6-6Z"
                         accessibleText="Carpeta vacía"/>
                <Label text="No hay archivos que coincidan" styleClass="empty-title"/>
                <Label text="Prueba con otros filtros o comparte un archivo desde un canal con el botón Adjuntar."
                       styleClass="subtitle" wrapText="true" textAlignment="CENTER"/>
                <Button fx:id="clearFiltersButton" text="Limpiar filtros"
                        styleClass="button-primary, button-compact" onAction="#onClearFilters"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
