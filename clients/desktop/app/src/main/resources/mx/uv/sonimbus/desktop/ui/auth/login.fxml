<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="mx.uv.sonimbus.desktop.ui.auth.LoginController"
           styleClass="auth-background"
           stylesheets="@../../css/theme.css">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox styleClass="auth-card" spacing="18" maxWidth="440" maxHeight="-Infinity">
        <padding>
            <Insets top="36" right="40" bottom="36" left="40"/>
        </padding>

        <!-- Encabezado -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="[Logo]" styleClass="logo-placeholder"
                   accessibleText="Logotipo de Sonimbus"/>
            <Label text="Iniciar sesión" styleClass="title"/>
            <Label text="Entra a tus grupos de Sonimbus" styleClass="subtitle"/>
        </VBox>

        <!-- Mensaje de error genérico (Fig. 10b), oculto por defecto -->
        <HBox fx:id="errorBox" styleClass="alert-error" spacing="10" alignment="CENTER_LEFT"
              visible="false" managed="false">
            <padding>
                <Insets top="12" right="14" bottom="12" left="14"/>
            </padding>
            <Label text="!" styleClass="alert-icon" accessibleText="Error"/>
            <Label fx:id="errorLabel" text="Correo o contraseña incorrectos"
                   styleClass="alert-text" wrapText="true"/>
        </HBox>

        <!-- Formulario. Los campos van antes que sus Label en el documento para
             que labelFor="$..." resuelva; el orden visual lo da rowIndex. -->
        <GridPane vgap="6">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <TextField fx:id="emailField" promptText="nombre@correo.com"
                       accessibleText="Correo electrónico"
                       GridPane.rowIndex="1"/>
            <Label text="Correo electrónico" labelFor="$emailField" styleClass="field-label"
                   GridPane.rowIndex="0"/>

            <HBox spacing="8" GridPane.rowIndex="3">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="passwordField" promptText="••••••••"
                                   accessibleText="Contraseña"/>
                    <TextField fx:id="passwordVisibleField" accessibleText="Contraseña visible"
                               visible="false" managed="false"/>
                </StackPane>
                <ToggleButton fx:id="showPasswordToggle" text="Mostrar"
                              accessibleText="Mostrar contraseña"
                              styleClass="button-secondary"
                              onAction="#onTogglePasswordVisibility"/>
            </HBox>
            <HBox alignment="BASELINE_LEFT" GridPane.rowIndex="2">
                <GridPane.margin>
                    <Insets top="8"/>
                </GridPane.margin>
                <Label text="Contraseña" labelFor="$passwordField" styleClass="field-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink fx:id="forgotPasswordLink" text="¿Olvidaste tu contraseña?"
                           onAction="#onForgotPassword"/>
            </HBox>
        </GridPane>

        <Button fx:id="loginButton" text="Iniciar sesión" defaultButton="true"
                maxWidth="1.7976931348623157E308" styleClass="button-primary"
                onAction="#onLogin"/>

        <!-- Separador "o" -->
        <HBox alignment="CENTER" spacing="12">
            <Separator HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
            <Label text="o" styleClass="subtitle"/>
            <Separator HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
        </HBox>

        <Button fx:id="googleButton" text="Continuar con Google"
                maxWidth="1.7976931348623157E308" styleClass="button-secondary, button-large"
                onAction="#onGoogleLogin">
            <graphic>
                <Label text="G" styleClass="provider-icon"/>
            </graphic>
        </Button>

        <HBox alignment="CENTER" spacing="4">
            <Label text="¿No tienes cuenta?" styleClass="subtitle"/>
            <Hyperlink fx:id="createAccountLink" text="Crear cuenta" styleClass="link-strong"
                       onAction="#onCreateAccount"/>
        </HBox>
    </VBox>
</StackPane>
