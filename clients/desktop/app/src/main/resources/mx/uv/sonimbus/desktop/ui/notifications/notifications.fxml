<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<!-- El prototipo lo dibuja como panel flotante bajo la campana; aquí es una vista
     completa que se carga en contentPane (el título lo pone el shell). -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.sonimbus.desktop.ui.notifications.NotificationsController"
            styleClass="content-view"
            stylesheets="@../../css/theme.css">

    <fx:define>
        <ToggleGroup fx:id="filterGroup"/>
    </fx:define>

    <top>
        <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="10" right="24" bottom="10" left="24"/>
            </padding>
            <HBox accessibleText="Filtro de notificaciones">
                <ToggleButton fx:id="allFilterToggle" text="Todas" selected="true"
                              toggleGroup="$filterGroup"
                              styleClass="button-secondary, segment-left"
                              accessibleText="Mostrar todas las notificaciones"
                              onAction="#onFilterChanged"/>
                <ToggleButton fx:id="unreadFilterToggle" text="No leídas (0)"
                              toggleGroup="$filterGroup"
                              styleClass="button-secondary, segment-right"
                              accessibleText="Mostrar solo las notificaciones no leídas"
                              onAction="#onFilterChanged"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="markAllReadButton" text="Marcar todas como leídas"
                    styleClass="button-secondary" onAction="#onMarkAllRead"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <ListView fx:id="notificationsList" styleClass="notification-list"
                      accessibleText="Notificaciones, la más reciente primero"/>
            <Label fx:id="emptyStateLabel" text="No tienes notificaciones"
                   styleClass="empty-state" mouseTransparent="true"
                   visible="false" managed="false"/>
        </StackPane>
    </center>
</BorderPane>
