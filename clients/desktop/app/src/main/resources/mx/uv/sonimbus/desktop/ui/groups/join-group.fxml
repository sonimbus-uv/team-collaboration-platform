<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Diálogo modal (Stage aparte): por eso la raíz sí lleva prefWidth -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.sonimbus.desktop.ui.groups.JoinGroupController"
      styleClass="dialog-root" spacing="16" prefWidth="520"
      stylesheets="@../../css/theme.css">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <Label text="Unirse a un grupo" styleClass="dialog-title"/>
    <Label text="Escribe el código de invitación que te compartió un administrador del grupo."
           styleClass="subtitle" wrapText="true"/>

    <!-- Error (invitación inválida, caducada, revocada o agotada), oculto por defecto -->
    <HBox fx:id="errorBox" styleClass="alert-error" spacing="10" alignment="CENTER_LEFT"
          visible="false" managed="false">
        <padding>
            <Insets top="12" right="14" bottom="12" left="14"/>
        </padding>
        <Label text="!" styleClass="alert-icon" accessibleText="Error"/>
        <Label fx:id="errorLabel" styleClass="alert-text" wrapText="true"/>
    </HBox>

    <GridPane vgap="6">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <TextField fx:id="inviteCodeField" styleClass="code-field-compact"
                   accessibleText="Código de invitación"
                   accessibleHelp="También puedes pegar el enlace de invitación completo."
                   GridPane.rowIndex="1"/>
        <Label text="Código de invitación" labelFor="$inviteCodeField" styleClass="field-label"
               GridPane.rowIndex="0"/>
        <Label text="También puedes pegar el enlace de invitación completo."
               styleClass="hint-text" wrapText="true" GridPane.rowIndex="2"/>
    </GridPane>

    <!-- Vista previa del grupo encontrado, oculta por defecto -->
    <HBox fx:id="groupPreviewBox" styleClass="info-card" spacing="12" alignment="CENTER_LEFT"
          visible="false" managed="false">
        <padding>
            <Insets top="12" right="14" bottom="12" left="14"/>
        </padding>
        <Label fx:id="groupInitialsLabel" styleClass="group-chip-light"/>
        <VBox spacing="2">
            <Label fx:id="groupNameLabel" styleClass="panel-item-title"/>
            <Label fx:id="groupDetailsLabel" styleClass="section-subtitle"/>
        </VBox>
    </HBox>

    <HBox styleClass="dialog-actions" alignment="CENTER_RIGHT" spacing="10">
        <padding>
            <Insets top="16"/>
        </padding>
        <Button fx:id="cancelButton" text="Cancelar" cancelButton="true"
                styleClass="button-secondary, button-compact" onAction="#onCancel"/>
        <Button fx:id="joinButton" text="Unirse" defaultButton="true"
                styleClass="button-primary, button-compact" onAction="#onJoinGroup"/>
    </HBox>
</VBox>
