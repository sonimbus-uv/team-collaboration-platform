<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.sonimbus.desktop.ui.auth.RecoverPasswordController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
            styleClass="auth-scroll"
            stylesheets="@../../css/theme.css">
    <StackPane styleClass="auth-background">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <VBox styleClass="auth-card" spacing="18" maxWidth="460" maxHeight="-Infinity">
            <padding>
                <Insets top="32" right="40" bottom="32" left="40"/>
            </padding>

            <!-- ===== Indicador de pasos (compartido) ===== -->
            <HBox fx:id="stepIndicator" spacing="8" alignment="CENTER_LEFT"
                  accessibleText="Paso 1 de 2">
                <Label fx:id="step1Badge" text="1" styleClass="step-badge, step-active"/>
                <Label fx:id="step1Label" text="Correo" styleClass="step-label, step-active"/>
                <Region fx:id="stepConnector" HBox.hgrow="ALWAYS" styleClass="step-connector"/>
                <Label fx:id="step2Badge" text="2" styleClass="step-badge"/>
                <Label fx:id="step2Label" text="Nueva contraseña" styleClass="step-label"/>
            </HBox>

            <!-- ===== Paso 1: correo ===== -->
            <VBox fx:id="emailStepBox" spacing="18">
                <VBox spacing="8">
                    <Label text="Recuperar contraseña" styleClass="title"/>
                    <Label text="Escribe el correo de tu cuenta y te enviaremos un código para restablecer tu contraseña."
                           styleClass="subtitle" wrapText="true"/>
                </VBox>

                <GridPane vgap="6">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <TextField fx:id="emailField" promptText="nombre@correo.com"
                               accessibleText="Correo electrónico" GridPane.rowIndex="1"/>
                    <Label text="Correo electrónico" labelFor="$emailField" styleClass="field-label"
                           GridPane.rowIndex="0"/>
                </GridPane>

                <Button fx:id="sendCodeButton" text="Enviar código" defaultButton="true"
                        maxWidth="1.7976931348623157E308" styleClass="button-primary"
                        onAction="#onSendCode"/>

                <!-- Mensaje neutro tras enviar, oculto por defecto -->
                <HBox fx:id="sentInfoBox" styleClass="alert-info" spacing="10" alignment="TOP_LEFT"
                      visible="false" managed="false">
                    <padding>
                        <Insets top="12" right="14" bottom="12" left="14"/>
                    </padding>
                    <Label text="i" styleClass="info-icon" accessibleText="Información"/>
                    <Label fx:id="sentInfoLabel"
                           text="Si el correo está registrado, recibirás un código para restablecer tu contraseña."
                           styleClass="info-text" wrapText="true"/>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Hyperlink fx:id="backToLoginLink" text="Volver a iniciar sesión"
                               onAction="#onBackToLogin"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink fx:id="haveCodeLink" text="Ya tengo un código" styleClass="link-strong"
                               onAction="#onShowResetStep"/>
                </HBox>
            </VBox>

            <!-- ===== Paso 2: código + nueva contraseña (oculto por defecto) ===== -->
            <VBox fx:id="resetStepBox" spacing="16" visible="false" managed="false">
                <VBox spacing="8">
                    <Label text="Crea una nueva contraseña" styleClass="title"/>
                    <Label text="Escribe el código que llegó a tu correo y elige tu nueva contraseña."
                           styleClass="subtitle" wrapText="true"/>
                </VBox>

                <!-- Error (código inválido/caducado), oculto por defecto -->
                <HBox fx:id="resetErrorBox" styleClass="alert-error" spacing="10" alignment="CENTER_LEFT"
                      visible="false" managed="false">
                    <padding>
                        <Insets top="12" right="14" bottom="12" left="14"/>
                    </padding>
                    <Label text="!" styleClass="alert-icon" accessibleText="Error"/>
                    <Label fx:id="resetErrorLabel" styleClass="alert-text" wrapText="true"/>
                </HBox>

                <GridPane vgap="6">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- Código -->
                    <TextField fx:id="codeField" promptText="000000"
                               styleClass="code-field-compact"
                               accessibleText="Código de recuperación"
                               GridPane.rowIndex="1"/>
                    <HBox alignment="BASELINE_LEFT" GridPane.rowIndex="0">
                        <Label text="Código de recuperación" labelFor="$codeField"
                               styleClass="field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Hyperlink fx:id="resendCodeLink" text="Reenviar código"
                                   onAction="#onResendCode"/>
                    </HBox>

                    <!-- Nueva contraseña -->
                    <HBox spacing="8" GridPane.rowIndex="3">
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="newPasswordField" accessibleText="Nueva contraseña"
                                           accessibleHelp="Mínimo 8 caracteres, con al menos una letra y un número."/>
                            <TextField fx:id="newPasswordVisibleField"
                                       accessibleText="Nueva contraseña visible"
                                       visible="false" managed="false"/>
                        </StackPane>
                        <ToggleButton fx:id="showPasswordToggle" text="Mostrar"
                                      accessibleText="Mostrar contraseña"
                                      styleClass="button-secondary"
                                      onAction="#onTogglePasswordVisibility"/>
                    </HBox>
                    <Label text="Nueva contraseña" labelFor="$newPasswordField" styleClass="field-label"
                           GridPane.rowIndex="2">
                        <GridPane.margin>
                            <Insets top="6"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Mínimo 8 caracteres, con al menos una letra y un número."
                           styleClass="hint-text" wrapText="true" GridPane.rowIndex="4"/>

                    <!-- Confirmación -->
                    <PasswordField fx:id="confirmPasswordField"
                                   accessibleText="Confirmar nueva contraseña"
                                   GridPane.rowIndex="6"/>
                    <Label text="Confirmar nueva contraseña" labelFor="$confirmPasswordField"
                           styleClass="field-label" GridPane.rowIndex="5">
                        <GridPane.margin>
                            <Insets top="6"/>
                        </GridPane.margin>
                    </Label>
                    <HBox fx:id="confirmPasswordErrorBox" spacing="6" alignment="CENTER_LEFT"
                          visible="false" managed="false" GridPane.rowIndex="7">
                        <Label text="!" styleClass="alert-icon-small" accessibleText="Error"/>
                        <Label fx:id="confirmPasswordErrorLabel" text="Las contraseñas no coinciden."
                               styleClass="field-error-text" wrapText="true"/>
                    </HBox>
                </GridPane>

                <Button fx:id="resetButton" text="Restablecer contraseña"
                        maxWidth="1.7976931348623157E308" styleClass="button-primary"
                        onAction="#onResetPassword"/>

                <HBox alignment="CENTER">
                    <Hyperlink fx:id="resetBackToLoginLink" text="Volver a iniciar sesión"
                               onAction="#onBackToLogin"/>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>
</ScrollPane>
