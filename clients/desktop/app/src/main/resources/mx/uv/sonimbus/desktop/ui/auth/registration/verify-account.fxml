<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import mx.uv.sonimbus.desktop.ui.theme.ThemeSelector?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="mx.uv.sonimbus.desktop.ui.auth.registration.VerifyAccountController" fitToWidth="true"
    fitToHeight="true" hbarPolicy="NEVER" styleClass="auth-scroll"
    stylesheets="@../../../css/theme.css">
    <StackPane styleClass="auth-background" minHeight="-Infinity">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <VBox styleClass="auth-card" spacing="20" maxWidth="460" maxHeight="-Infinity"
            minHeight="-Infinity">
            <padding>
                <Insets top="36" right="40" bottom="36" left="40"/>
            </padding>

            <HBox alignment="CENTER_RIGHT" spacing="8" styleClass="appearance-bar">
                <Label text="Apariencia" styleClass="hint-text"/>
                <ThemeSelector/>
            </HBox>

            <VBox alignment="CENTER" spacing="10">
                <StackPane styleClass="envelope-icon" accessibleText="Correo enviado"
                    maxWidth="-Infinity" maxHeight="-Infinity">
                    <SVGPath content="M2 2 L20 15 L38 2" styleClass="envelope-stroke"/>
                </StackPane>
                <Label text="Verifica tu cuenta" styleClass="title"/>
                <TextFlow textAlignment="CENTER" lineSpacing="2">
                    <Text text="Solicitaste un código de verificación para&#10;"
                        styleClass="flow-text"/>
                    <Text fx:id="sentToEmailText" text="tu correo" styleClass="flow-text-strong"/>
                    <Text text=".&#10;Introduce el código de 8 dígitos que recibiste."
                        styleClass="flow-text"/>
                </TextFlow>
            </VBox>

            <HBox fx:id="errorBox" styleClass="alert-error" spacing="10" alignment="TOP_LEFT"
                visible="false" managed="false" minHeight="-Infinity">
                <padding>
                    <Insets top="12" right="14" bottom="12" left="14"/>
                </padding>
                <Label fx:id="errorIconLabel" text="!" styleClass="alert-icon"
                    accessibleText="Error"/>
                <Label fx:id="errorLabel" styleClass="alert-text" wrapText="true"
                    minHeight="-Infinity" minWidth="0" maxWidth="1.7976931348623157E308"
                    HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox fx:id="infoBox" styleClass="alert-info" spacing="10" alignment="TOP_LEFT"
                visible="false" managed="false" minHeight="-Infinity">
                <padding>
                    <Insets top="12" right="14" bottom="12" left="14"/>
                </padding>
                <Label text="i" styleClass="info-icon" accessibleText="Información"/>
                <Label fx:id="infoLabel" text="Usa el código más reciente." styleClass="info-text"
                    wrapText="true" minHeight="-Infinity" minWidth="0"
                    maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
            </HBox>

            <VBox spacing="8">
                <Label text="Código de verificación" labelFor="$codeField"/>
                <TextField fx:id="codeField" promptText="00000000" onAction="#onVerifyCode"
                    accessibleText="Código de verificación de 8 dígitos"/>
                <Label fx:id="expirationLabel" wrapText="true" styleClass="subtitle"
                    minHeight="-Infinity" minWidth="0" maxWidth="1.7976931348623157E308"/>
            </VBox>
            <Button fx:id="verifyButton" text="Verificar cuenta" defaultButton="true"
                maxWidth="1.7976931348623157E308" styleClass="button-primary"
                onAction="#onVerifyCode"/>

            <Separator/>
            <VBox alignment="CENTER" spacing="8">
                <Label text="¿No te llegó el correo? Revisa tu carpeta de spam."
                    styleClass="subtitle" wrapText="true" minHeight="-Infinity" minWidth="0"
                    maxWidth="1.7976931348623157E308"/>
                <Button fx:id="resendButton" text="Reenviar correo" styleClass="button-secondary"
                    accessibleText="Reenviar correo de verificación" onAction="#onResendEmail"/>
            </VBox>

            <VBox alignment="CENTER" spacing="12">
                <Hyperlink fx:id="restartRegistrationLink" text="Iniciar un nuevo registro"
                    onAction="#onRestartRegistration" wrapText="true" minHeight="-Infinity"
                    maxWidth="1.7976931348623157E308" alignment="CENTER" textAlignment="CENTER"/>
                <Hyperlink fx:id="backToLoginLink" text="Volver a iniciar sesión"
                    onAction="#onBackToLogin" wrapText="true" minHeight="-Infinity"
                    maxWidth="1.7976931348623157E308" alignment="CENTER" textAlignment="CENTER"/>
            </VBox>
        </VBox>
    </StackPane>
</ScrollPane>
