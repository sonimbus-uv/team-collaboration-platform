<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- El prototipo navega con la columna de canales; aquí las secciones son pestañas
     y "Volver al grupo" / "Abandonar grupo" van en la barra superior de la vista. -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="mx.uv.sonimbus.desktop.ui.groups.GroupSettingsController"
           styleClass="content-view"
           stylesheets="@../../css/theme.css">

    <fx:define>
        <ToggleGroup fx:id="channelTypeGroup"/>
    </fx:define>

    <BorderPane fx:id="settingsPane">
        <!-- ================= Barra de la vista ================= -->
        <top>
            <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="12">
                <padding>
                    <Insets top="10" right="24" bottom="10" left="24"/>
                </padding>
                <Button fx:id="backButton" text="Volver al grupo" styleClass="button-secondary"
                        onAction="#onBackToGroup">
                    <graphic>
                        <SVGPath styleClass="icon-stroke, icon-small" content="M19 12H5M11 6l-6 6 6 6"/>
                    </graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="leaveGroupButton" text="Abandonar grupo" styleClass="button-secondary"
                        onAction="#onLeaveGroup"/>
            </HBox>
        </top>

        <center>
            <TabPane fx:id="settingsTabs" styleClass="settings-tabs" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <!-- ================= General (CU-09) ================= -->
                    <Tab fx:id="generalTab" text="General">
                        <content>
                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="plain-scroll">
                                <VBox spacing="20" maxWidth="760">
                                    <padding>
                                        <Insets top="24" right="28" bottom="24" left="28"/>
                                    </padding>

                                    <!-- Agregado: resultado de guardar, oculto por defecto -->
                                    <HBox fx:id="generalErrorBox" styleClass="alert-error" spacing="10"
                                          alignment="CENTER_LEFT" visible="false" managed="false">
                                        <padding>
                                            <Insets top="12" right="14" bottom="12" left="14"/>
                                        </padding>
                                        <Label text="!" styleClass="alert-icon" accessibleText="Error"/>
                                        <Label fx:id="generalErrorLabel" styleClass="alert-text" wrapText="true"/>
                                    </HBox>

                                    <GridPane vgap="6">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <TextField fx:id="groupNameField" accessibleText="Nombre del grupo"
                                                   GridPane.rowIndex="1"/>
                                        <Label text="Nombre del grupo" labelFor="$groupNameField"
                                               styleClass="field-label" GridPane.rowIndex="0"/>

                                        <TextArea fx:id="groupDescriptionArea" prefRowCount="3" wrapText="true"
                                                  accessibleText="Descripción del grupo"
                                                  accessibleHelp="Máximo 200 caracteres."
                                                  GridPane.rowIndex="3"/>
                                        <Label text="Descripción" labelFor="$groupDescriptionArea"
                                               styleClass="field-label" GridPane.rowIndex="2">
                                            <GridPane.margin>
                                                <Insets top="8"/>
                                            </GridPane.margin>
                                        </Label>
                                        <Label fx:id="groupDescriptionCountLabel" text="0 / 200"
                                               styleClass="hint-text" GridPane.rowIndex="4"
                                               GridPane.halignment="RIGHT"/>
                                    </GridPane>

                                    <HBox spacing="10">
                                        <Button fx:id="saveButton" text="Guardar cambios" defaultButton="true"
                                                styleClass="button-primary, button-compact"
                                                onAction="#onSaveGeneral"/>
                                        <Button fx:id="discardButton" text="Descartar"
                                                styleClass="button-secondary, button-compact"
                                                onAction="#onDiscardGeneral"/>
                                    </HBox>

                                    <!-- Zona de riesgo -->
                                    <VBox fx:id="dangerZoneBox" styleClass="danger-zone" spacing="14">
                                        <padding>
                                            <Insets top="16" right="18" bottom="16" left="18"/>
                                        </padding>
                                        <Label text="Zona de riesgo · solo administradores"
                                               styleClass="panel-title"/>
                                        <HBox alignment="CENTER_LEFT" spacing="16">
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <Label text="Archivar grupo" styleClass="panel-item-title"/>
                                                <Label text="El grupo queda en solo lectura. Puedes restaurarlo después."
                                                       styleClass="section-subtitle" wrapText="true"/>
                                            </VBox>
                                            <Button fx:id="archiveGroupButton" text="Archivar"
                                                    styleClass="button-secondary, button-compact"
                                                    minWidth="-Infinity" onAction="#onArchiveGroup"/>
                                        </HBox>
                                        <Separator/>
                                        <HBox alignment="CENTER_LEFT" spacing="16">
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <Label text="Eliminar grupo" styleClass="panel-item-title"/>
                                                <Label text="Se borran canales, mensajes, archivos y proyectos. No se puede deshacer."
                                                       styleClass="section-subtitle" wrapText="true"/>
                                            </VBox>
                                            <Button fx:id="deleteGroupButton" text="Eliminar grupo"
                                                    styleClass="button-danger" minWidth="-Infinity"
                                                    onAction="#onDeleteGroup"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </ScrollPane>
                        </content>
                    </Tab>

                    <!-- ================= Invitaciones (CU-10) ================= -->
                    <Tab fx:id="invitationsTab" text="Invitaciones">
                        <content>
                            <VBox spacing="18">
                                <padding>
                                    <Insets top="22" right="28" bottom="22" left="28"/>
                                </padding>

                                <!-- Generar invitación -->
                                <GridPane styleClass="info-card" hgap="14" vgap="6" minHeight="-Infinity">
                                    <padding>
                                        <Insets top="14" right="16" bottom="14" left="16"/>
                                    </padding>
                                    <ComboBox fx:id="maxUsesCombo" prefWidth="180"
                                              accessibleText="Usos máximos de la invitación"
                                              GridPane.rowIndex="1" GridPane.columnIndex="0">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="1 uso"/>
                                                <String fx:value="5 usos"/>
                                                <String fx:value="10 usos"/>
                                                <String fx:value="Sin límite"/>
                                            </FXCollections>
                                        </items>
                                    </ComboBox>
                                    <Label text="Usos máximos" labelFor="$maxUsesCombo" styleClass="field-label"
                                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <ComboBox fx:id="expirationCombo" prefWidth="180"
                                              accessibleText="Caducidad de la invitación"
                                              GridPane.rowIndex="1" GridPane.columnIndex="1">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="1 hora"/>
                                                <String fx:value="1 día"/>
                                                <String fx:value="7 días"/>
                                                <String fx:value="Nunca"/>
                                            </FXCollections>
                                        </items>
                                    </ComboBox>
                                    <Label text="Caduca en" labelFor="$expirationCombo" styleClass="field-label"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    <Button fx:id="generateInviteButton" text="Generar código"
                                            styleClass="button-primary, button-compact"
                                            onAction="#onGenerateInvite"
                                            GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                </GridPane>

                                <!-- Lista de invitaciones -->
                                <TableView fx:id="invitationsTable" styleClass="data-table"
                                           accessibleText="Invitaciones del grupo" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                    <placeholder>
                                        <Label text="Todavía no hay invitaciones" styleClass="empty-state"/>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="inviteCodeColumn" text="Código" prefWidth="140"/>
                                        <TableColumn fx:id="inviteCreatorColumn" text="Creada por" prefWidth="160"/>
                                        <TableColumn fx:id="inviteUsesColumn" text="Usos restantes" prefWidth="130"/>
                                        <TableColumn fx:id="inviteExpirationColumn" text="Caducidad" prefWidth="130"/>
                                        <TableColumn fx:id="inviteStatusColumn" text="Estado" prefWidth="120"/>
                                        <TableColumn fx:id="inviteActionsColumn" text="Acciones" prefWidth="190"
                                                     sortable="false"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- ================= Canales (CU-13) ================= -->
                    <Tab fx:id="channelsTab" text="Canales">
                        <content>
                            <VBox spacing="12">
                                <padding>
                                    <Insets top="22" right="28" bottom="22" left="28"/>
                                </padding>

                                <!-- Nuevo canal -->
                                <GridPane styleClass="info-card" hgap="14" vgap="6" minHeight="-Infinity">
                                    <padding>
                                        <Insets top="14" right="16" bottom="14" left="16"/>
                                    </padding>
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints/>
                                        <ColumnConstraints/>
                                    </columnConstraints>
                                    <TextField fx:id="newChannelNameField" promptText="ej. entregas"
                                               accessibleText="Nombre del nuevo canal"
                                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <Label text="Nombre del nuevo canal" labelFor="$newChannelNameField"
                                           styleClass="field-label"
                                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <HBox fx:id="channelTypeBox" spacing="14" alignment="CENTER_LEFT"
                                          accessibleText="Tipo de canal"
                                          GridPane.rowIndex="1" GridPane.columnIndex="1">
                                        <RadioButton fx:id="textTypeRadio" text="Texto" selected="true"
                                                     toggleGroup="$channelTypeGroup"/>
                                        <RadioButton fx:id="voiceTypeRadio" text="Voz"
                                                     toggleGroup="$channelTypeGroup"/>
                                    </HBox>
                                    <Label text="Tipo" labelFor="$channelTypeBox" styleClass="field-label"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    <Button fx:id="createChannelButton" text="Crear canal"
                                            styleClass="button-primary, button-compact"
                                            onAction="#onCreateChannel"
                                            GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                </GridPane>

                                <Label fx:id="textChannelsCountLabel" text="CANALES DE TEXTO (0)"
                                       styleClass="section-heading">
                                    <VBox.margin>
                                        <Insets top="6"/>
                                    </VBox.margin>
                                </Label>
                                <ListView fx:id="textChannelsList" styleClass="row-list"
                                          accessibleText="Canales de texto" VBox.vgrow="ALWAYS"
                                          minHeight="96" prefHeight="150"/>

                                <Label fx:id="voiceChannelsCountLabel" text="CANALES DE VOZ (0)"
                                       styleClass="section-heading">
                                    <VBox.margin>
                                        <Insets top="6"/>
                                    </VBox.margin>
                                </Label>
                                <ListView fx:id="voiceChannelsList" styleClass="row-list"
                                          accessibleText="Canales de voz" VBox.vgrow="ALWAYS"
                                          minHeight="96" prefHeight="150"/>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- ================= Miembros y roles (CU-14) ================= -->
                    <Tab fx:id="membersTab" text="Miembros y roles">
                        <content>
                            <VBox spacing="14">
                                <padding>
                                    <Insets top="20" right="28" bottom="20" left="28"/>
                                </padding>

                                <HBox alignment="BOTTOM_LEFT" spacing="16">
                                    <Label fx:id="membersCountLabel" text="MIEMBROS (0)"
                                           styleClass="section-heading"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <GridPane vgap="4">
                                        <TextField fx:id="memberSearchField" promptText="Nombre o correo"
                                                   prefWidth="260" accessibleText="Buscar miembro"
                                                   onAction="#onSearchMember" GridPane.rowIndex="1"/>
                                        <Label text="Buscar miembro" labelFor="$memberSearchField"
                                               styleClass="filter-label" GridPane.rowIndex="0"/>
                                    </GridPane>
                                </HBox>

                                <TableView fx:id="membersTable" styleClass="data-table"
                                           accessibleText="Miembros del grupo" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                    <placeholder>
                                        <Label text="Sin miembros que mostrar" styleClass="empty-state"/>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="memberColumn" text="Miembro" prefWidth="340"/>
                                        <TableColumn fx:id="memberRoleColumn" text="Rol" prefWidth="200"
                                                     sortable="false"/>
                                        <TableColumn fx:id="memberActionsColumn" text="Acciones" prefWidth="220"
                                                     sortable="false"/>
                                    </columns>
                                </TableView>

                                <HBox alignment="CENTER_LEFT" spacing="6">
                                    <Label fx:id="membersShownLabel" text="Mostrando 0 de 0"
                                           styleClass="section-subtitle"/>
                                    <Hyperlink fx:id="showAllMembersLink" text="Ver todos"
                                               onAction="#onShowAllMembers"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- ================= Moderación (CU-15), sin prototipo ================= -->
                    <Tab fx:id="moderationTab" text="Moderación">
                        <content>
                            <VBox spacing="14">
                                <padding>
                                    <Insets top="20" right="28" bottom="20" left="28"/>
                                </padding>

                                <Label fx:id="blockedCountLabel" text="BLOQUEADOS (0)"
                                       styleClass="section-heading"/>
                                <Label text="Un miembro bloqueado no puede volver a unirse con una invitación. Para expulsar o bloquear a alguien usa la pestaña «Miembros y roles»."
                                       styleClass="section-subtitle" wrapText="true"/>

                                <TableView fx:id="blockedTable" styleClass="data-table"
                                           accessibleText="Miembros bloqueados" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                    <placeholder>
                                        <Label text="No hay miembros bloqueados" styleClass="empty-state"/>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="blockedMemberColumn" text="Miembro" prefWidth="300"/>
                                        <TableColumn fx:id="blockedDateColumn" text="Bloqueado el" prefWidth="140"/>
                                        <TableColumn fx:id="blockedByColumn" text="Bloqueado por" prefWidth="180"/>
                                        <TableColumn fx:id="blockedActionsColumn" text="Acciones" prefWidth="160"
                                                     sortable="false"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </center>
    </BorderPane>

    <!-- ===== Confirmación de eliminar grupo (Config-eliminar), oculta por defecto ===== -->
    <StackPane fx:id="deleteConfirmOverlay" styleClass="modal-scrim" visible="false" managed="false">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        <VBox styleClass="dialog-card" spacing="16" maxWidth="520" maxHeight="-Infinity">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <Label fx:id="deleteTitleLabel" text="¿Eliminar el grupo?" styleClass="dialog-title"
                   wrapText="true"/>
            <Label fx:id="deleteDescriptionLabel"
                   text="Se borrarán de forma permanente todos los canales, mensajes, archivos y proyectos del grupo, y sus miembros perderán el acceso. Esta acción no se puede deshacer."
                   styleClass="dialog-text" wrapText="true"/>
            <GridPane vgap="6">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <TextField fx:id="deleteConfirmField"
                           accessibleText="Nombre del grupo para confirmar la eliminación"
                           accessibleHelp="El botón Eliminar grupo se activa cuando el nombre coincide exactamente."
                           GridPane.rowIndex="1"/>
                <Label fx:id="deleteConfirmLabel" text="Escribe el nombre del grupo para confirmar"
                       labelFor="$deleteConfirmField" styleClass="field-label" wrapText="true"
                       GridPane.rowIndex="0"/>
                <Label text="El botón se activa cuando el nombre coincide exactamente."
                       styleClass="hint-text" wrapText="true" GridPane.rowIndex="2"/>
            </GridPane>
            <HBox styleClass="dialog-actions" alignment="CENTER_RIGHT" spacing="10">
                <padding>
                    <Insets top="16"/>
                </padding>
                <Button fx:id="cancelDeleteButton" text="Cancelar" cancelButton="true"
                        styleClass="button-secondary, button-compact" onAction="#onCancelDelete"/>
                <Button fx:id="confirmDeleteButton" text="Eliminar grupo" disable="true"
                        styleClass="button-danger" onAction="#onConfirmDelete"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
