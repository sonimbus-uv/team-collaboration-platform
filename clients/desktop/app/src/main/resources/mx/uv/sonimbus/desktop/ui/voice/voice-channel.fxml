<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.sonimbus.desktop.ui.voice.VoiceChannelController"
            styleClass="content-view"
            stylesheets="@../../css/theme.css">

    <!-- ================= Avisos (ocultos por defecto) ================= -->
    <top>
        <VBox fx:id="noticesBox" spacing="10" visible="false" managed="false">
            <padding>
                <Insets top="16" right="24" left="24"/>
            </padding>

            <!-- Voz no disponible -->
            <HBox fx:id="unavailableBox" styleClass="alert-error" spacing="12" alignment="CENTER_LEFT"
                  visible="false" managed="false">
                <padding>
                    <Insets top="10" right="14" bottom="10" left="14"/>
                </padding>
                <Label text="!" styleClass="alert-icon" accessibleText="Error"/>
                <Label fx:id="unavailableLabel" text="La voz no está disponible por el momento"
                       styleClass="alert-text" wrapText="true"
                       HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
                <Button fx:id="retryButton" text="Reintentar" styleClass="button-secondary"
                        onAction="#onRetry"/>
            </HBox>

            <!-- Agregado: aviso de "solo escucha" (no está en el prototipo) -->
            <HBox fx:id="listenOnlyBox" styleClass="alert-info" spacing="10" alignment="CENTER_LEFT"
                  visible="false" managed="false">
                <padding>
                    <Insets top="12" right="14" bottom="12" left="14"/>
                </padding>
                <Label text="i" styleClass="info-icon" accessibleText="Información"/>
                <Label fx:id="listenOnlyLabel"
                       text="Estás en modo solo escucha: puedes oír a los demás, pero no transmitir audio."
                       styleClass="info-text" wrapText="true"/>
            </HBox>
        </VBox>
    </top>

    <!-- ================= Participantes ================= -->
    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="20" right="24" bottom="20" left="24"/>
            </padding>
            <Label fx:id="participantsCountLabel" text="PARTICIPANTES (0)" styleClass="section-heading"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="plain-scroll"
                        VBox.vgrow="ALWAYS">
                <TilePane fx:id="participantsPane" hgap="16" vgap="16" prefColumns="2"
                          accessibleText="Participantes del canal de voz"/>
            </ScrollPane>
        </VBox>
    </center>

    <!-- ================= Controles de la llamada ================= -->
    <bottom>
        <HBox styleClass="bottom-bar" alignment="CENTER" spacing="16">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>
            <ToggleButton fx:id="muteToggle" text="Silenciar"
                          styleClass="button-secondary, button-large, call-button"
                          onAction="#onToggleMute">
                <graphic>
                    <SVGPath fx:id="muteIcon" styleClass="icon-stroke, icon-small"
                             content="M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3Z M5 11a7 7 0 0 0 14 0M12 18v3"/>
                </graphic>
            </ToggleButton>
            <Button fx:id="leaveButton" text="Salir" styleClass="button-primary, call-button"
                    onAction="#onLeave">
                <graphic>
                    <SVGPath styleClass="icon-stroke-on-primary, icon-small"
                             content="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10"/>
                </graphic>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
