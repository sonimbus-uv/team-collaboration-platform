<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.sonimbus.desktop.ui.auth.VerifyAccountController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
            styleClass="auth-scroll"
            stylesheets="@../../css/theme.css">
    <StackPane styleClass="auth-background">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <VBox styleClass="auth-card" spacing="20" maxWidth="460" maxHeight="-Infinity">
            <padding>
                <Insets top="36" right="40" bottom="36" left="40"/>
            </padding>

            <!-- Encabezado -->
            <VBox alignment="CENTER" spacing="10">
                <StackPane styleClass="envelope-icon" accessibleText="Correo enviado"
                           maxWidth="-Infinity" maxHeight="-Infinity">
                    <SVGPath content="M2 2 L20 15 L38 2" styleClass="envelope-stroke"/>
                </StackPane>
                <Label text="Verifica tu cuenta" styleClass="title"/>
                <TextFlow textAlignment="CENTER" lineSpacing="2">
                    <Text text="Enviamos un enlace de verificación a&#10;" styleClass="flow-text"/>
                    <!-- El controlador pone el correo registrado; sin él (demostración) queda «tu correo» -->
                    <Text fx:id="sentToEmailText" text="tu correo" styleClass="flow-text-strong"/>
                    <Text text=".&#10;Ábrelo desde tu correo para activar tu cuenta." styleClass="flow-text"/>
                </TextFlow>
            </VBox>

            <!-- Error (el correo no se pudo enviar al registrar o falló el reenvío), oculto por defecto -->
            <HBox fx:id="errorBox" styleClass="alert-error" spacing="10" alignment="CENTER_LEFT"
                  visible="false" managed="false">
                <padding>
                    <Insets top="12" right="14" bottom="12" left="14"/>
                </padding>
                <Label fx:id="errorIconLabel" text="!" styleClass="alert-icon" accessibleText="Error"/>
                <Label fx:id="errorLabel" styleClass="alert-text" wrapText="true"/>
            </HBox>

            <!-- Resultado del reenvío: mensaje neutro (no revela si la cuenta existe), oculto por defecto.
                 Antes era un código de 6 dígitos (codeField); se recuperaría si #14 adopta la alternativa A. -->
            <HBox fx:id="infoBox" styleClass="alert-info" spacing="10" alignment="CENTER_LEFT"
                  visible="false" managed="false">
                <padding>
                    <Insets top="12" right="14" bottom="12" left="14"/>
                </padding>
                <Label text="i" styleClass="info-icon" accessibleText="Información"/>
                <Label fx:id="infoLabel"
                       text="Si la cuenta existe y no está verificada, te enviamos un nuevo enlace."
                       styleClass="info-text" wrapText="true"/>
            </HBox>

            <Button fx:id="verifyButton" text="Ya verifiqué mi cuenta" defaultButton="true"
                    accessibleHelp="Vuelve a iniciar sesión después de abrir el enlace del correo."
                    maxWidth="1.7976931348623157E308" styleClass="button-primary"
                    onAction="#onAlreadyVerified"/>

            <!-- Reenvío -->
            <Separator/>
            <VBox alignment="CENTER" spacing="8">
                <Label text="¿No te llegó el correo? Revisa tu carpeta de spam."
                       styleClass="subtitle" wrapText="true"/>
                <Button fx:id="resendButton" text="Reenviar correo" styleClass="button-secondary"
                        accessibleText="Reenviar correo de verificación"
                        onAction="#onResendEmail"/>
            </VBox>

            <HBox alignment="CENTER">
                <Hyperlink fx:id="backToLoginLink" text="Volver a iniciar sesión"
                           onAction="#onBackToLogin"/>
            </HBox>
        </VBox>
    </StackPane>
</ScrollPane>
