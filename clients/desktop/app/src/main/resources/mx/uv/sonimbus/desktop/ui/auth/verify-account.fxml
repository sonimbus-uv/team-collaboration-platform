<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.sonimbus.desktop.ui.auth.VerifyAccountController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
            styleClass="auth-scroll"
            stylesheets="@../../css/theme.css">
    <StackPane styleClass="auth-background">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <VBox styleClass="auth-card" spacing="20" maxWidth="460" maxHeight="-Infinity">
            <padding>
                <Insets top="36" right="40" bottom="36" left="40"/>
            </padding>

            <!-- Encabezado -->
            <VBox alignment="CENTER" spacing="10">
                <StackPane styleClass="envelope-icon" accessibleText="Correo enviado"
                           maxWidth="-Infinity" maxHeight="-Infinity">
                    <SVGPath content="M2 2 L20 15 L38 2" styleClass="envelope-stroke"/>
                </StackPane>
                <Label text="Verifica tu cuenta" styleClass="title"/>
                <TextFlow textAlignment="CENTER" lineSpacing="2">
                    <Text text="Enviamos un código de verificación a&#10;" styleClass="flow-text"/>
                    <Text fx:id="sentToEmailText" text="[correo]" styleClass="flow-text-strong"/>
                    <Text text=".&#10;Escríbelo para activar tu cuenta." styleClass="flow-text"/>
                </TextFlow>
            </VBox>

            <!-- Error (código incorrecto o caducado), oculto por defecto -->
            <HBox fx:id="errorBox" styleClass="alert-error" spacing="10" alignment="CENTER_LEFT"
                  visible="false" managed="false">
                <padding>
                    <Insets top="12" right="14" bottom="12" left="14"/>
                </padding>
                <Label text="!" styleClass="alert-icon" accessibleText="Error"/>
                <Label fx:id="errorLabel" styleClass="alert-text" wrapText="true"/>
            </HBox>

            <!-- Confirmación de reenvío, oculta por defecto -->
            <HBox fx:id="infoBox" styleClass="alert-success" spacing="10" alignment="CENTER_LEFT"
                  visible="false" managed="false">
                <padding>
                    <Insets top="12" right="14" bottom="12" left="14"/>
                </padding>
                <Label text="✓" styleClass="success-icon" accessibleText="Listo"/>
                <Label fx:id="infoLabel" text="Te enviamos un nuevo código."
                       styleClass="success-text" wrapText="true"/>
            </HBox>

            <!-- Código -->
            <GridPane vgap="6">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <TextField fx:id="codeField" promptText="000000" styleClass="code-field"
                           accessibleText="Código de verificación"
                           accessibleHelp="6 dígitos. El código caduca en 15 minutos."
                           GridPane.rowIndex="1"/>
                <Label text="Código de verificación" labelFor="$codeField" styleClass="field-label"
                       GridPane.rowIndex="0"/>
                <Label text="6 dígitos. El código caduca en 15 minutos." styleClass="hint-text"
                       wrapText="true" GridPane.rowIndex="2"/>
            </GridPane>

            <Button fx:id="verifyButton" text="Verificar cuenta" defaultButton="true"
                    maxWidth="1.7976931348623157E308" styleClass="button-primary"
                    onAction="#onVerify"/>

            <!-- Reenvío -->
            <Separator/>
            <VBox alignment="CENTER" spacing="8">
                <Label text="¿No te llegó el correo? Revisa tu carpeta de spam."
                       styleClass="subtitle" wrapText="true"/>
                <Button fx:id="resendButton" text="Reenviar código" styleClass="button-secondary"
                        onAction="#onResendCode"/>
            </VBox>

            <HBox alignment="CENTER">
                <Hyperlink fx:id="backToLoginLink" text="Volver a iniciar sesión"
                           onAction="#onBackToLogin"/>
            </HBox>
        </VBox>
    </StackPane>
</ScrollPane>
