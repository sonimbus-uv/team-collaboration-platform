# Variables de entorno de Core para desarrollo y pruebas (config/runtime.exs).
# Phoenix no lee este archivo: exporta las variables en la shell antes de usar
# mix. CORE_DB_PASSWORD debe coincidir con la de infrastructure/.env, porque
# postgres-init crea el usuario con ese valor.

CORE_DB_USER=core_service
CORE_DB_PASSWORD=change_this_core_db_password
CORE_DB_HOST=localhost
CORE_DB_PORT=5432
CORE_DB_NAME=team_collaboration

# Puerto HTTP de Core (serie 3000 de servicios internos).
PORT=3002

# Verificación del access JWT (contracts/token-profile.md). CORE_JWT_ISSUER
# debe ser igual a AUTH_JWT_ISSUER de Auth. En desarrollo, si no se definen,
# se usan https://auth.example.invalid y el JWKS de Auth en el puerto 3001.
CORE_JWT_ISSUER=https://auth.example.invalid
CORE_JWKS_URL=http://localhost:3001/.well-known/jwks.json
