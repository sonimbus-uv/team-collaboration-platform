SERVER_ADDR=0.0.0.0:3001

DATABASE_URL=postgres://team_user:change_me_postgres@localhost:5432/team_collaboration
DATABASE_MAX_CONNECTIONS=10

# mailpit for development; resend for production (default when unset).
EMAIL_PROVIDER=mailpit

EMAIL_FROM="Team <noreply@example.com>"
# Public Auth Service GET endpoint; HTTPS required outside localhost.
EMAIL_VERIFICATION_URL=http://localhost:3001/auth/verify-email
MAX_CONCURRENT_HASHES=4

MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
# Captured emails: http://localhost:8025 (web UI, not SMTP).

# Required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=replace_with_resend_api_key
