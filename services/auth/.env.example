SERVER_ADDR=0.0.0.0:3001

# Empty means no trusted proxies; direct clients cannot override their IP.
# Comma-separated exact IP addresses, without ports or CIDR.
TRUSTED_PROXY_IPS=172.30.250.2

# Initial test policies; tune using observed traffic.
# REFILL_SECS is the time to refill an empty bucket completely.
AUTH_REGISTER_IP_CAPACITY=6
AUTH_REGISTER_IP_REFILL_SECS=60

AUTH_RESEND_IP_CAPACITY=3
AUTH_RESEND_IP_REFILL_SECS=60

# Shared by GET and POST email verification.
AUTH_VERIFY_IP_CAPACITY=20
AUTH_VERIFY_IP_REFILL_SECS=60

# Shared email-send budget per recipient; never used to confirm a token.
AUTH_RECIPIENT_CAPACITY=3
AUTH_RECIPIENT_REFILL_SECS=3600

DATABASE_URL=postgres://team_user:change_me_postgres@localhost:5432/team_collaboration
DATABASE_MAX_CONNECTIONS=10

# mailpit for development; resend for production (default when unset).
EMAIL_PROVIDER=mailpit

EMAIL_FROM="Team <noreply@example.com>"
# Public Auth Service GET endpoint; HTTPS required outside localhost.
EMAIL_VERIFICATION_URL=http://localhost:3001/auth/verify-email
MAX_CONCURRENT_HASHES=4

MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
# Captured emails: http://localhost:8025 (web UI, not SMTP).

# Required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=replace_with_resend_api_key

# Redis published on the development host.
# Replace the example password in the local .env.
REDIS_URL=redis://:password_vagrant_infraestructure@127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_OPERATION_TIMEOUT_MS=200

# Required: generate a random secret locally.
# All Auth replicas must use exactly the same value.
AUTH_RECIPIENT_HMAC_SECRET=replace_with_a_random_32_byte_secret
