SERVER_ADDR=0.0.0.0:3001

# SAFETY: keep disabled until #17 and its recovery/enumeration contract are resolved.
# Tests explicitly enable login only in isolated databases.
AUTH_LOGIN_ENABLED=false

# Internal session checks: separate HTTPS listener, explicitly enabled after provisioning.
# Invalid/missing internal configuration when enabled prevents Auth from starting.
AUTH_INTERNAL_ENABLED=false
AUTH_INTERNAL_ADDR=127.0.0.1:3443
AUTH_INTERNAL_ALLOWED_CIDRS=127.0.0.1/32,::1/128
AUTH_INTERNAL_CREDENTIALS_PATH=/run/secrets/auth-internal-credentials.json
AUTH_INTERNAL_CERT_PATH=/etc/sonimbus/auth-internal-cert.pem
AUTH_INTERNAL_KEY_PATH=/run/secrets/auth-internal-tls.key
# Independent internal budgets. Quotas/concurrency per service are shared through Redis.
AUTH_INTERNAL_BODY_LIMIT_BYTES=65536
AUTH_INTERNAL_PAIR_CAPACITY=100
AUTH_INTERNAL_PAIRS_PER_SECOND=100
AUTH_INTERNAL_CONCURRENT_PER_SERVICE=20
AUTH_INTERNAL_PREAUTH_PER_SECOND=10
# This limit is LOCAL to each process, for connections and in-flight HTTP requests.
AUTH_INTERNAL_LOCAL_LIMIT=50
AUTH_INTERNAL_REQUEST_TIMEOUT_MS=1000
AUTH_INTERNAL_SQL_TIMEOUT_MS=500
AUTH_INTERNAL_REDIS_CONNECT_TIMEOUT_MS=200
AUTH_INTERNAL_REDIS_OPERATION_TIMEOUT_MS=100
AUTH_INTERNAL_LEASE_TTL_MS=2000
AUTH_INTERNAL_HANDSHAKE_TIMEOUT_MS=300
AUTH_INTERNAL_HEADER_TIMEOUT_MS=1000

# Proposed operational budgets; count all attempts without disclosing account existence.
AUTH_LOGIN_IP_CAPACITY=6
AUTH_LOGIN_IP_REFILL_SECS=60
AUTH_REFRESH_IP_CAPACITY=30
AUTH_REFRESH_IP_REFILL_SECS=60
AUTH_LOGOUT_IP_CAPACITY=30
AUTH_LOGOUT_IP_REFILL_SECS=60
AUTH_LOGIN_ACCOUNT_CAPACITY=10
AUTH_LOGIN_ACCOUNT_REFILL_SECS=900

# Required. Provision files explicitly; Auth never creates signing keys at startup.
# Private: unencrypted Ed25519 PKCS#8 PEM, owned by Auth, mode 0600/0400 on Unix.
# Public JWKS includes active and retained keys, never a private `d` field.
AUTH_JWT_PRIVATE_KEY_PATH=/run/secrets/auth-ed25519.pem
AUTH_JWT_JWKS_PATH=/etc/sonimbus/auth-public-jwks.json
AUTH_JWT_ACTIVE_KID=auth-example-2026-10
AUTH_JWT_ISSUER=https://auth.example.invalid
AUTH_JWT_AUDIENCES=sonimbus-core,sonimbus-files,sonimbus-auth

# Empty means no trusted proxies; direct clients cannot override their IP.
# Comma-separated exact IP addresses, without ports or CIDR.
TRUSTED_PROXY_IPS=172.30.250.2
REQUIRE_TRUSTED_PROXY=true

# Initial test policies; tune using observed traffic.
# REFILL_SECS is the time to refill an empty bucket completely.
AUTH_REGISTER_IP_CAPACITY=6
AUTH_REGISTER_IP_REFILL_SECS=60

AUTH_RESEND_IP_CAPACITY=3
AUTH_RESEND_IP_REFILL_SECS=60

# Shared by GET and POST email verification.
AUTH_VERIFY_IP_CAPACITY=20
AUTH_VERIFY_IP_REFILL_SECS=60

# Budget for eligible resends per recipient; registration does not consume it.
AUTH_RECIPIENT_CAPACITY=3
AUTH_RECIPIENT_REFILL_SECS=3600

DATABASE_URL=postgres://team_user:change_me_postgres@localhost:5432/team_collaboration
DATABASE_MAX_CONNECTIONS=10

# mailpit for development; resend for production (default when unset).
EMAIL_PROVIDER=mailpit

EMAIL_FROM="Team <noreply@example.com>"
# Public Auth Service GET endpoint; HTTPS required outside localhost.
EMAIL_VERIFICATION_URL=http://localhost:8080/auth/verify-email
MAX_CONCURRENT_HASHES=4

MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
# Captured emails: http://localhost:8025 (web UI, not SMTP).

# Required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=replace_with_resend_api_key

# Redis published on the development host.
# Replace the example password in the local .env.
REDIS_URL=redis://:password_vagrant_infraestructure@127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_OPERATION_TIMEOUT_MS=200

# Required: generate a random secret locally.
# All Auth replicas must use exactly the same value.
AUTH_RECIPIENT_HMAC_SECRET=replace_with_a_random_32_byte_secret
