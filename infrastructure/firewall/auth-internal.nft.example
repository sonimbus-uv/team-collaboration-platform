# PREPARED ONLY. Not included by auth-firewall.service or provision.sh.
# Match this port/CIDRs with AUTH_INTERNAL_ADDR/AUTH_INTERNAL_ALLOWED_CIDRS.
# The example is loopback-only. Replace with approved Core/Files source networks
# for deployment; never add the public Nginx network as an allowed internal source.
# Validate only: sudo nft -c -f infrastructure/firewall/auth-internal.nft.example
add table inet auth_internal_guard
flush table inet auth_internal_guard

table inet auth_internal_guard {
    chain input {
        type filter hook input priority -11; policy accept;

        iifname "lo" ip saddr 127.0.0.1 tcp dport 3443 counter accept
        iifname "lo" ip6 saddr ::1 tcp dport 3443 counter accept
        tcp dport 3443 counter reject with tcp reset
    }
}
