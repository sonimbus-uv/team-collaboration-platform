[Unit]
Description=Auth service network access protection
After=local-fs.target nftables.service
Before=docker.service

[Service]
Type=oneshot
ExecStartPre=/usr/sbin/nft -c -f /etc/team-collaboration-platform/auth.nft
ExecStart=/usr/sbin/nft -f /etc/team-collaboration-platform/auth.nft
ExecReload=/usr/sbin/nft -f /etc/team-collaboration-platform/auth.nft
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target