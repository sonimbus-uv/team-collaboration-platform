# ==================================================
# Variables locales de infraestructura
# Copiar a infrastructure/.env y reemplazar todos los valores change_this_*.
# `vagrant provision` agrega a .env las variables nuevas de este archivo
# sin modificar las existentes.
# ==================================================

# ==================================================
# PostgreSQL (D-13)
# Superusuario de la instancia: solo para administración y para
# postgres-init. Los servicios usan su propio usuario (abajo).
# ==================================================

POSTGRES_DB=team_collaboration
POSTGRES_USER=team_user
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_PORT=5432

# Contraseñas de los usuarios por servicio (T-04).
# Usuarios: auth_service, core_service, files_service, reports_service.
AUTH_DB_PASSWORD=change_this_auth_db_password
CORE_DB_PASSWORD=change_this_core_db_password
FILES_DB_PASSWORD=change_this_files_db_password
REPORTS_DB_PASSWORD=change_this_reports_db_password

# ==================================================
# Redis
# ==================================================

REDIS_PASSWORD=change_this_redis_password
REDIS_PORT=6379

# ==================================================
# Mailpit
# ==================================================

MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ==================================================
# ScyllaDB (perfil messaging, D-05)
# SCYLLA_MEMORY es la memoria de ScyllaDB; SCYLLA_MEM_LIMIT, el límite del
# contenedor, debe ser mayor para dejar margen.
# ==================================================

SCYLLA_VERSION=2026.3
SCYLLA_PORT=9042
SCYLLA_SMP=1
SCYLLA_MEMORY=750M
SCYLLA_MEM_LIMIT=1g

# ==================================================
# MinIO (perfil storage)
# ==================================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=sonimbus-files
