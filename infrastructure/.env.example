# ==================================================
# PostgreSQL
# ==================================================

POSTGRES_DB=team_platform
POSTGRES_USER=team_platform_user
POSTGRES_PASSWORD=change_this_postgres_password

# ==================================================
# Redis
# ==================================================

REDIS_PASSWORD=change_this_redis_password

# ==================================================
# Mailpit
# ==================================================

MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ==================================================
# ScyllaDB
# ==================================================

SCYLLA_CLUSTER_NAME=TeamCollaborationCluster
SCYLLA_PORT=9042
# Memoria del motor; reservar margen adicional para el contenedor.
SCYLLA_MEMORY=1G
SCYLLA_MEM_LIMIT=1536M

# ==================================================
# MinIO
# ==================================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001